# THE Brain — Local Development Environment Variables
# Copy this file to .dev.vars and fill in real values
# .dev.vars is gitignored — never commit secrets

# Neon Postgres connection string (legacy direct-connection var; the retired
# engine container used it — kept until the prod secret is retired in Phase 13)
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
NEON_CONNECTION_STRING=postgresql://user:password@localhost:5432/brain_dev

# Local canonical Postgres fallback when HYPERDRIVE_CANONICAL is unavailable
# in wrangler dev / tests. Production canonical access should use Hyperdrive.
CANONICAL_POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/brain_dev

# Cloudflare AI Gateway ID (created in dashboard)
AI_GATEWAY_ID=haetsal-brain-gateway

# Cloudflare account id for AI Gateway compat URL
AI_GATEWAY_ACCOUNT_ID=d3f0a1c579945862edc9c6f6e36e448a

# Cloudflare AI Gateway token (gateway auth; provider key stays in AI Gateway BYOK)
AI_GATEWAY_TOKEN=cf-aig-xxxxxxxxxxxx

# Google OAuth web client for Gmail + Calendar. Production values belong in
# Worker secrets; never commit the client secret.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ─── Sendblue iMessage integration (mission Phase 4) ─────────────────────────
# Sendblue sends sb-signing-secret. The bearer path segment remains a second layer.
# Free Tier: shared number, up to 10 verified contacts, must-text-first, 24h reply window.
SENDBLUE_API_KEY_ID=00000000000000000000000000000000
SENDBLUE_API_SECRET_KEY=00000000000000000000000000000000
SENDBLUE_PHONE_NUMBER=+1XXXXXXXXXX
SENDBLUE_WEBHOOK_PATH_SECRET=generate-with-openssl-rand-hex-32
SENDBLUE_WEBHOOK_SIGNING_SECRET=copy-from-sendblue-webhook-signing-secret
